#!/bin/sh
# Strip Cursor co-author trailer from commit messages.
MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Portable in-place edit (Git Bash / macOS / Linux)
tmp="${MSG_FILE}.tmp.$$"
grep -v -E '^Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>[[:space:]]*$' "$MSG_FILE" > "$tmp" && mv "$tmp" "$MSG_FILE"
exit 0
